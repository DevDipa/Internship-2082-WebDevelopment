@model List<BookieDookie.Controllers.AdminUserViewModel>

@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}

<link rel="stylesheet"
      href="~/css/admin.css"
      asp-append-version="true" />

<div class="admin-dashboard">

    <!-- ==========================================
         HEADER
         ========================================== -->

    <div class="admin-header">

        <div class="admin-heading">


            <h1>Manage Users</h1>

            <p>
                View, manage and maintain the readers of BookieDookie.
            </p>

        </div>

        <div class="admin-badge">

            <i class="fas fa-users"></i>

            <div>
                <strong>User Management</strong>
                <span>@Model.Count registered users</span>
            </div>

        </div>

    </div>


    <!-- ==========================================
         ERROR MESSAGE
         ========================================== -->

    @if (TempData["AdminError"] != null)
    {
        <div class="admin-alert">

            <i class="fas fa-circle-exclamation"></i>

            @TempData["AdminError"]

        </div>
    }


    <!-- ==========================================
         USER TABLE
         ========================================== -->

    <div class="admin-section-card">

        <div class="section-heading">

            <div>

                <span class="section-kicker">
                    THE READERS
                </span>

                <h2>User Management</h2>

            </div>

            <span class="user-count">
                @Model.Count reader@(Model.Count == 1 ? "" : "s")
            </span>

        </div>


        @if (!Model.Any())
        {
            <div class="empty-admin-state">

                <i class="fas fa-users-slash"></i>

                <p>
                    No users are currently registered.
                </p>

            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>

                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Books</th>
                            <th>Pages</th>
                            <th>Streak</th>
                            <th>Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <!-- ==================================
                                 USER
                                 ================================== -->

                            <td>

                                <div class="user-cell">

                                    <div class="user-avatar">

                                        @if (!string.IsNullOrEmpty(user.Username))
                                        {
                                            @user.Username.Substring(0, 1).ToUpper()
                                        }
                                        else
                                        {
                                            <span>?</span>
                                        }

                                    </div>

                                    <div>

                                        <strong>
                                            @user.Username
                                        </strong>

                                        <small>
                                            @user.Email
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- ==================================
                                 ROLE
                                 ================================== -->

                            <td>

                                @if (user.Role == BookieDookie.Models.UserRole.Admin)
                                {
                                    <span class="role-badge admin-role">

                                        <i class="fas fa-crown"></i>

                                        Admin

                                    </span>
                                }
                                else
                                {
                                    <span class="role-badge user-role">
                                        Reader
                                    </span>
                                }

                            </td>


                            <!-- ==================================
                                 STATUS
                                 ================================== -->

                            <td>

                                @if (user.Status == BookieDookie.Models.UserStatus.Active)
                                {
                                    <span class="status-badge active-status">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive-status">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <!-- ==================================
                                 BOOKS
                                 ================================== -->

                            <td>

                                <span class="table-number">
                                    @user.BookCount
                                </span>

                            </td>


                            <!-- ==================================
                                 PAGES
                                 ================================== -->

                            <td>

                                <span class="table-number">
                                    @user.PagesRead
                                </span>

                            </td>


                            <!-- ==================================
                                 STREAK
                                 ================================== -->

                            <td>

                                <span class="streak-value">

                                    @user.ReadingStreak
                                    <span>🔥</span>

                                </span>

                            </td>


                            <!-- ==================================
                                 ACTIONS
                                 ================================== -->

                            <td>

                                <div class="admin-user-actions">

                                    <!-- ACTIVATE / DEACTIVATE -->

                                    <form asp-controller="Admin"
                                          asp-action="ToggleUserStatus"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@user.UserId" />

                                        @if (user.Status == BookieDookie.Models.UserStatus.Active)
                                        {
                                            <button type="submit"
                                                    class="admin-action-button deactivate-button"
                                                    title="Deactivate User">

                                                <i class="fas fa-user-slash"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="admin-action-button activate-button"
                                                    title="Activate User">

                                                <i class="fas fa-user-check"></i>

                                            </button>
                                        }

                                    </form>


                                    <!-- DELETE -->

                                    <form asp-controller="Admin"
                                          asp-action="DeleteUser"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@user.UserId" />

                                        <button type="submit"
                                                class="admin-action-button delete-button"
                                                title="Delete User">

                                            <i class="fas fa-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>