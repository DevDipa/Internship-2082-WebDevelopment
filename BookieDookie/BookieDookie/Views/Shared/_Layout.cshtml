<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BookieDookie</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookieDookie.styles.css" asp-append-version="true" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            overflow: hidden;
        }
    </style>
</head>

<body>

<div class="dashboard-container">

    @{
        var currentController =
            ViewContext.RouteData.Values["Controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["Action"]?.ToString();
    }


    <!-- =========================================================
         ADMIN SIDEBAR
         ========================================================= -->

    @if (currentController == "Admin")
    {
<!-- Sidebar -->
<aside class="sidebar">

    <div class="sidebar-logo">
        <i class="fas fa-book-open"></i>
        <span>BookieDookie</span>
    </div>

    <nav class="sidebar-nav">

        @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin")
        {
            <!-- =========================
                 ADMIN SIDEBAR
                 ========================= -->

            <a asp-controller="Admin"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-house-chimney"></i>
                <span>Home</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Users"
               class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" ? "active" : "")">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Books"
               class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Books" ? "active" : "")">
                <i class="fas fa-book"></i>
                <span>Books</span>
            </a>

            <a asp-controller="Admin"
               asp-action="ReadingStats"
               class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "ReadingStats" ? "active" : "")">
                <i class="fas fa-chart-area"></i>
                <span>Reading Stats</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Settings"
               class="nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")">
                <i class="fas fa-gear"></i>
                <span>Settings</span>
            </a>

            <a asp-controller="Login"
               asp-action="Logout"
               class="nav-item">
                <i class="fas fa-plane-departure"></i>
                <span>Log Out</span>
            </a>
        }
        else
        {
            <!-- =========================
                 USER SIDEBAR
                 ========================= -->

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="fas fa-house-chimney"></i>
                <span>Home</span>
            </a>

            <a asp-controller="Book"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Book" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fas fa-heart"></i>
                <span>My Bookshelf</span>
            </a>

            <a asp-controller="ReadingStats"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ReadingStats" ? "active" : "")">
                <i class="fas fa-chart-area"></i>
                <span>Reading Stats</span>
            </a>

            <a asp-controller="Book"
               asp-action="Create"
               class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Book" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")">
                <i class="fas fa-feather-pointed"></i>
                <span>Add a Book</span>
            </a>

            <a asp-controller="Profile"
               asp-action="Edit"
               class="nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profile" ? "active" : "")">
                <i class="fas fa-user-astronaut"></i>
                <span>Profile</span>
            </a>

            <a asp-controller="Login"
               asp-action="Logout"
               class="nav-item">
                <i class="fas fa-plane-departure"></i>
                <span>Log Out</span>
            </a>
        }

    </nav>

</aside>
    }

    else
    {
        <!-- =====================================================
             USER SIDEBAR
             ===================================================== -->

        <aside class="sidebar">

            <!-- USER LOGO -->

            <div class="sidebar-logo">

                <i class="fas fa-book-open"></i>

                <span>BookieDookie</span>

            </div>


            <!-- USER NAVIGATION -->

            <nav class="sidebar-nav">

                <!-- HOME -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-item @(currentController == "Home" ? "active" : "")">

                    <i class="fas fa-house-chimney"></i>

                    <span>Home</span>

                </a>


                <!-- MY BOOKSHELF -->

                <a asp-controller="Book"
                   asp-action="Index"
                   class="nav-item @(currentController == "Book" && currentAction == "Index" ? "active" : "")">

                    <i class="fas fa-heart"></i>

                    <span>My Bookshelf</span>

                </a>


                <!-- READING STATS -->

                <a asp-controller="ReadingStats"
                   asp-action="Index"
                   class="nav-item @(currentController == "ReadingStats" ? "active" : "")">

                    <i class="fas fa-chart-area"></i>

                    <span>Reading Stats</span>

                </a>


                <!-- ADD A BOOK -->

                <a asp-controller="Book"
                   asp-action="Create"
                   class="nav-item @(currentController == "Book" && currentAction == "Create" ? "active" : "")">

                    <i class="fas fa-feather-pointed"></i>

                    <span>Add a Book</span>

                </a>


                <!-- PROFILE -->

                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="nav-item @(currentController == "Profile" ? "active" : "")">

                    <i class="fas fa-user-astronaut"></i>

                    <span>Profile</span>

                </a>


                <!-- LOG OUT -->

                <a asp-controller="Login"
                   asp-action="Logout"
                   class="nav-item">

                    <i class="fas fa-plane-departure"></i>

                    <span>Log Out</span>

                </a>

            </nav>

        </aside>
    }


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="main-content">

        @RenderBody()

    </div>

</div>


<!-- =============================================================
     FOOTER
     ============================================================= -->

<footer class="footer text-muted fa-align-left">

    &copy; 2026 - BookieDookie | Dipaak

</footer>


<!-- =============================================================
     SCRIPTS
     ============================================================= -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

<script src="~/lib/font-awesome/all.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
